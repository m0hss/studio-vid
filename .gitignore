# Dependencies (regenerate with npm install)
node_modules/
.npm/
.cache/

# Local tooling: ffmpeg/ffprobe symlinks point at a machine-specific path
.tools/

# Render outputs and logs (regenerable with `hyperframes render`)
# The final delivery video and the intro pitches are kept; other renders are not.
out/*
!out/fixbyte-studio-promo.mp4
!out/fixbyte-studio-promo-reel.mp4
!out/fixbyte-studio-promo-voiceover.mp4
!out/fixbyte-studio-promo-fr.mp4
!out/intros/
project/renders/
*.log
*.mp4
*.mov
!out/fixbyte-studio-promo.mp4
!out/fixbyte-studio-promo-reel.mp4
!out/fixbyte-studio-promo-voiceover.mp4
!out/fixbyte-studio-promo-fr.mp4
!out/intros/*.mp4

# Screen recordings (large, not needed to build the video)
assets/screencasts/

# HyperFrames local state and locks
.hyperframes/

# Build intermediates (regenerate with tools/build_audio.py)
project/assets/audio/mix_raw.wav
project/assets/audio/mix_fr_raw.wav

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Package manager debug output
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Temp files
*.tmp
*.bak
